[Unit]
Description=ED-AIC3000 golden image: per-unit identity on first boot
Documentation=file:///usr/local/sbin/aic3000-firstboot.sh
# Runs once, on the first boot after the image was flashed (seal-golden.sh
# leaves /etc/machine-id as "uninitialized"), and before every normal service:
# networking, mDNS, SSH, VNC and the application all start with the new
# identity.
ConditionFirstBoot=yes
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=sysinit.target first-boot-complete.target
Wants=first-boot-complete.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/aic3000-firstboot.sh
StandardOutput=journal+console

[Install]
WantedBy=sysinit.target
