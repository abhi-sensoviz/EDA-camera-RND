#!/bin/sh
# ED-AIC3000: keep the fixed fallback address 192.168.1.10 out of mDNS (.local)
# answers while a DHCP address exists, so <hostname>.local always points at the
# DHCP address. Avahi skips "deprecated" addresses unless they are the only
# ones; a deprecated address still accepts connections normally.
[ "$1" = eth0 ] || exit 0
case "$2" in up|dhcp4-change|reapply) ;; *) exit 0 ;; esac
ip -4 addr show dev eth0 | grep -q "inet 192.168.1.10/" || exit 0
ip addr change 192.168.1.10/24 dev eth0 preferred_lft 0
