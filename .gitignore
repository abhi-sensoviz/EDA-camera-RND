# Full eMMC images: too large, kept locally (see os-backup/README.md)
os-backup/*
!os-backup/README.md

# Master OS images (exact clones of a set-up camera): too large for git, and
# they hold the application, password hashes and keys. Their checksums and disk
# layout are tracked; the capture log names the application, so it stays local.
master-os-backup/*.img
master-os-backup/*.img.zst
master-os-backup/*.img.gz
master-os-backup/*.log

# EDATEC-owned files: not redistributed.
# Download links and SHA-256 checksums are in aic3000-backup/README.md.
aic3000-backup/vendor-debs/*.deb
aic3000-backup/installed-files/*.tar.gz
aic3000-backup/reverse-engineering/
aic3000-backup/hardware/overlay-ed-imx477.dts

# All PDFs: EDATEC's manual and datasheet, plus the network guide
# (its text, with the camera MAC redacted, is in aic3000-backup/docs/*.txt)
*.pdf

# Full internal versions of documents: internal application details and
# device identifiers (serial number, MAC). The public versions sit beside them.
*.private.*

# Generated output
__pycache__/
*.pyc
af_results/
